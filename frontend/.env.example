# FastAPI backend (the OpenCV flatten + /extract endpoint)
NEXT_PUBLIC_SCAN_API=http://localhost:8000

NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe Supabase key. Either name works — set ONE of these, not both.
# New-style projects issue a publishable key (sb_publishable_...); older ones
# issue an anon JWT (eyJ...). Never put the service role or sb_secret_ key here:
# anything prefixed NEXT_PUBLIC_ is compiled into the client bundle.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
